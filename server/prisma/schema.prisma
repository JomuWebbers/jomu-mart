generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?   @default("")
  avatar    String?   @default("")
  role      String    @default("customer") // "customer" | "admin"
  addresses Address[]
  orders    Order[]
  returnRequests            ReturnRequest[] 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
   accountBalance            Float    @default(0)
  linkedBankAccountNumber   String?
  linkedBankName            String?
  isTrustedVendor           Boolean  @default(false)
  trustedVendorRequestStatus String? @default("none")  // "none" | "pending" | "approved" | "rejected"
  products Product[]
  reviews Review[]
  sellerListingFees SellerListingFee[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String
  state     String
  zip       String
  isDefault Boolean  @default(false)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?  @default("")
  price         Float
  originalPrice Float?   @default(0)
  image         String
  images        String[] @default([])
  category      String
  subcategory   String?  @default("")
  stock         Int?     @default(0)
  rating        Float?   @default(0)
  reviewCount   Int?     @default(0)

  sellerId          String
  seller            User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status            String   @default("pending")
  negotiable        String?  @default("no")

  fulfillmentMethod String?  @default("dropoff")
  sellerState       String?
  sellerLga         String?
  sellerAddress     String?

  deliveryDays        Int?
  chargesDeliveryFee  Boolean? @default(false)
  deliveryFeeAmount   Float?   @default(0)

  listingFeePaid    Boolean  @default(false)
  listingFeeAmount  Float?   @default(0)

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  shippingAddress Json
  paymentMethod   String   @default("card")
  subtotal        Float
  deliveryFee     Float?   @default(0)
  tax             Float?   @default(0)
  total           Float
  status          String   @default("Placed")
  statusHistory   Json

  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  deliveryOtp       String?          @default("")
  liveLocation      Json?
  isPaid            Boolean?         @default(false)
  returnRequests            ReturnRequest[] 
  reviews         Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([orderId])
}

model DeliveryPartner {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  phone       String
  avatar      String?  @default("")
  vehicleType String?  @default("bike")
  isActive    Boolean? @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SellerListingFee {
  id                String   @id @default(cuid())
  sellerId          String
  seller            User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  monthKey          String
  firstProductId    String
  reference         String?  @unique
  authorizationUrl  String?
  amountKobo        Int      @default(100000)
  status            String   @default("pending") // pending | paid
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sellerId, monthKey])
}

model ReturnRequest {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Details submitted by customer
  reason          String   // e.g. "Damaged / Defective", "Wrong item", "Not as described"
  comments        String?  @default("")
  images          String[] @default([]) // Photo proofs uploaded by customer

  // Financial & status tracking
  refundAmount    Float
  refundMethod    String   @default("wallet") // "wallet" | "bank" | "original_payment"
  status          String   @default("pending") // "pending" | "approved" | "rejected" | "item_picked_up" | "refunded"
  adminNote       String?  @default("") // Reason if rejected, or inspection notes
  statusHistory   Json?    @default("[]") // [{ status, timestamp, note }]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
}



