# ---- Database (required) ----
# Pooled connection string. Neon pooler hosts end in -pooler.<region>.aws.neon.tech.
# Keep pgbouncer=true and connection_limit=1: this app runs one shared PrismaClient
# (server/src/lib/prisma.ts), so each extra connection is wasted pool capacity.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/naija-mart?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection. Required by the Prisma CLI for migrations
# (datasource.directUrl in schema.prisma) - migrate deploy needs a direct socket.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/naija-mart?sslmode=require"

# ---- Auth (required) ----
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# ---- CORS + Paystack callbacks (required) ----
# The deployed CLIENT origin, no trailing slash. Used for two things:
#   1. added to the CORS allowlist in server/src/server.ts
#   2. building the listing-fee callback_url, so it must be where the client is served
FRONTEND_URL="http://localhost:5173"

# ---- Payments (required) ----
# Paystack SECRET key. Use an sk_test_ key for test transactions; sk_live_ in production.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Image uploads (required) ----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- Support chat (required) ----
# Without these, the support widget and all automated seller notifications fail.
# Failures here are caught and logged, they never roll back a payment.
STREAM_API_KEY="your-stream-api-key"
STREAM_API_SECRET="your-stream-api-secret"