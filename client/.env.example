# ---- API base URL (required in every environment) ----
# api.ts reads this at build time: import.meta.env.VITE_API_URL || 'http://localhost:5000/api'
# Vite inlines it into the bundle, so it is baked in at BUILD time, not read at runtime.
# Setting it ONLY on the host is not enough for some hosts - confirm the built bundle
# contains your production URL before shipping.
#   local dev : http://localhost:5000/api
#   production: https://<your-api-domain>/api
#
# PRODUCTION NOTE: use the API's FINAL hostname. Browsers can reject redirects
# during CORS preflight, even when /health and curl appear healthy.
VITE_API_URL="https://jomu-mart-server-eight.vercel.app/api"

# ---- Payments ----
# Paystack PUBLIC key (safe to expose in the browser bundle). This sample is test-mode.
# Use a pk_test_ key with the server's PAYSTACK_SECRET_KEY sk_test_ key, or a pk_live_
# key with the server's sk_live_ key. Set the server secret only in the server's
# environment (see server/.env.example); never put it in a VITE_ variable or client file.
# Used for card checkout and listing-fee payments.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_48458c9743044a62837eccc2ea222f03c8de3312"
