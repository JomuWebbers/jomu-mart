# ---- API base URL (required in every environment) ----
# api.ts reads this at build time: import.meta.env.VITE_API_URL || 'http://localhost:5000/api'
# Vite inlines it into the bundle, so it is baked in at BUILD time, not read at runtime.
# Setting it ONLY on the host is not enough for some hosts - confirm the built bundle
# contains your production URL before shipping.
#   local dev : http://localhost:5000/api
#   production: https://<your-api-domain>/api
#
# PRODUCTION NOTE: this must be the API's FINAL hostname. The pre-rename API
# domain (naija-mart-server-eight.vercel.app) only 307-redirects here, and
# browsers refuse to follow redirects on a CORS preflight - so a bundle pointing
# at the old host fails every request with "Redirect is not allowed for a
# preflight request", while /health and curl still return 200 and look healthy.
VITE_API_URL="https://jomu-mart-server-eight.vercel.app/api"

# ---- Payments ----
# Paystack PUBLIC key (safe to expose in the browser bundle; never put the secret key here).
# pk_test_ for test mode, pk_live_ for production. Currently unused by code paths -
# order checkout takes Bank Transfer / Pay on Delivery, and listing fees redirect to Paystack.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

